{
  "properties": {
    "path": {
      "minLength": 1,
      "pattern": "^[^/\\\\:\\x00-\\x1f]+(/[^/\\\\:\\x00-\\x1f]+)*$",
      "title": "Path",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    }
  },
  "required": [
    "path",
    "sha256",
    "size_bytes",
    "media_type"
  ],
  "title": "AssetRef",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
