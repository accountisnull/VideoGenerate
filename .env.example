# 媒体工具：填写 PATH 中的程序名、绝对路径或相对项目根目录的路径。
# Windows 路径建议使用正斜杠，例如 'C:/Tools/ffmpeg/bin/ffmpeg.exe'。
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 应用数据目录：支持相对项目根目录的路径或绝对路径。
VIDEO_DATA_DIR=data

# 文本模型：根据百炼账号所在地域填写接口地址和实际模型 ID。
# 共用密钥；各步骤也可通过 API_KEY_ENV 指定其他密钥变量名。
DASHSCOPE_API_KEY=

# 写稿模型：生成口播稿、发布标题和话题标签。
TEXT_WRITING_BASE_URL=
TEXT_WRITING_MODEL=
TEXT_WRITING_API_KEY_ENV=DASHSCOPE_API_KEY
TEXT_WRITING_TIMEOUT_SECONDS=60
TEXT_WRITING_GENERATION_OPTIONS='{}'

# 检查模型：按内容规则检查口播稿。
TEXT_REVIEW_BASE_URL=
TEXT_REVIEW_MODEL=
TEXT_REVIEW_API_KEY_ENV=DASHSCOPE_API_KEY
TEXT_REVIEW_TIMEOUT_SECONDS=60
TEXT_REVIEW_GENERATION_OPTIONS='{}'

# 改稿模型：根据检查反馈修改口播稿。
TEXT_REVISION_BASE_URL=
TEXT_REVISION_MODEL=
TEXT_REVISION_API_KEY_ENV=DASHSCOPE_API_KEY
TEXT_REVISION_TIMEOUT_SECONDS=60
TEXT_REVISION_GENERATION_OPTIONS='{}'

# 同质化检测：使用本地 BGE-M3 dense；填写完整权重目录，不提交模型。
# 此配置只供显式调用本模块使用，主生产流程由人员 6 接入。
SIMILARITY_MODEL_PATH=
# 必填：用 python -m app.content.cli fingerprint --model-path <目录> 生成。
SIMILARITY_MODEL_REVISION=
SIMILARITY_INDEX_VERSION=bge-m3-dense-cls-l2-cosine-v1
# 模型加载、指纹核对和推理合计硬超时，单位秒，必须为正数。
SIMILARITY_EMBEDDING_TIMEOUT_SECONDS=120
# PATH 与 URL 必须且只能填写一个。路径相对项目根目录。
# 本地磁盘模式只允许一个进程拥有该目录；共享进程使用 Qdrant 服务端。
SIMILARITY_QDRANT_PATH=data/vector-index
SIMILARITY_QDRANT_URL=
SIMILARITY_COLLECTION=content_similarity_bge_m3_v1
SIMILARITY_QDRANT_TIMEOUT_SECONDS=10
# 可信编排层必须提供以下所有检查的通过记录，可以追加，不能删去基础三项。
SIMILARITY_REQUIRED_CHECKS=keywords,content_audit,similarity
