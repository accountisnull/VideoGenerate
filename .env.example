# 媒体工具：填写 PATH 中的程序名、绝对路径或相对项目根目录的路径。
# Windows 路径建议使用正斜杠，例如 'C:/Tools/ffmpeg/bin/ffmpeg.exe'。
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 应用数据目录：支持相对项目根目录的路径或绝对路径。
VIDEO_DATA_DIR=data

# 文本模型：根据百炼账号所在地域填写接口地址和实际模型 ID。
# 共用密钥；各步骤也可通过 API_KEY_ENV 指定其他密钥变量名。
DASHSCOPE_API_KEY=

# 写稿模型：生成口播稿、发布标题和话题标签。
TEXT_WRITING_BASE_URL=
TEXT_WRITING_MODEL=
TEXT_WRITING_API_KEY_ENV=DASHSCOPE_API_KEY
TEXT_WRITING_TIMEOUT_SECONDS=60
TEXT_WRITING_GENERATION_OPTIONS='{}'

# 检查模型：按内容规则检查口播稿。
TEXT_REVIEW_BASE_URL=
TEXT_REVIEW_MODEL=
TEXT_REVIEW_API_KEY_ENV=DASHSCOPE_API_KEY
TEXT_REVIEW_TIMEOUT_SECONDS=60
TEXT_REVIEW_GENERATION_OPTIONS='{}'

# 改稿模型：根据检查反馈修改口播稿。
TEXT_REVISION_BASE_URL=
TEXT_REVISION_MODEL=
TEXT_REVISION_API_KEY_ENV=DASHSCOPE_API_KEY
TEXT_REVISION_TIMEOUT_SECONDS=60
TEXT_REVISION_GENERATION_OPTIONS='{}'

# 内容服务独立数据库，路径相对项目根目录；不要指向集成 app.db。
CONTENT_DATABASE_PATH=data/content/content.db
# 内容模块共享资产根目录；目前只交付文本，尚不读写媒体文件。
CONTENT_ASSET_ROOT=data/assets
# 本地 HTTP 服务令牌，可留空用于受控本机联调；不能复用模型密钥。
CONTENT_SERVICE_TOKEN=
# 内容供应商：disabled 保持未就绪；bailian 启用百炼兼容模式适配。
# 启用时三组 TEXT_* 地址、模型、密钥必须完整，模型须支持非流式 JSON 输出。
CONTENT_PROVIDER=disabled
# 执行方式：http 直接调用；deepagents 加载主管 Skill（需要 content 可选依赖）。
CONTENT_ENGINE=http
# 热点增强默认关闭；启用后仍保留原始 topic，不改变公共 HTTP 输入。
CONTENT_TRENDING_ENABLED=false
# 平台按此顺序轮转；数量 1～50；各源并行超时（秒），须小于主管调用预算。
TRENDING_PLATFORMS=weibo,baidu,douyin
TRENDING_LIMIT=20
TRENDING_TIMEOUT_SECONDS=8
# 默认无凭据公开来源；微博为第三方 UAPI，条款和长期可用性需部署方确认。
TRENDING_WEIBO_URL=https://uapis.cn/api/v1/misc/hotboard?type=weibo
TRENDING_BAIDU_URL=https://top.baidu.com/board?tab=realtime
TRENDING_DOUYIN_URL=https://www.iesdouyin.com/web/api/v2/hotsearch/billboard/word/
# 明确指定核对过的词表与审核要求；相对项目根目录。示例为 config/rules/content.example.json。
CONTENT_RULES_PATH=

# 同质化检测：使用本地 BGE-M3 dense；填写完整权重目录，不提交模型。
# 独立 CLI/MCP 使用；内容服务通过 CONTENT_SIMILARITY_ENABLED 显式启用。
SIMILARITY_MODEL_PATH=
# 必填：用 python -m app.content.cli fingerprint --model-path <目录> 生成。
SIMILARITY_MODEL_REVISION=
SIMILARITY_INDEX_VERSION=bge-m3-dense-cls-l2-cosine-v1
# 模型加载、指纹核对和推理合计硬超时，单位秒，必须为正数。
SIMILARITY_EMBEDDING_TIMEOUT_SECONDS=120
# PATH 与 URL 必须且只能填写一个。路径相对项目根目录。
# 本地磁盘模式只允许一个进程拥有该目录；共享进程使用 Qdrant 服务端。
SIMILARITY_QDRANT_PATH=data/vector-index
SIMILARITY_QDRANT_URL=
SIMILARITY_COLLECTION=content_similarity_bge_m3_v1
SIMILARITY_QDRANT_TIMEOUT_SECONDS=10
# 可信编排层必须提供以下所有检查的通过记录，可以追加，不能删去基础三项。
SIMILARITY_REQUIRED_CHECKS=keywords,content_audit,similarity

# 内容主管接入 vector-mcp；未准备模型和显式初始化的索引时保持 false。
CONTENT_SIMILARITY_ENABLED=false
# 启动 stdio MCP 的 Python，可指向安装 similarity 可选组的独立环境。
CONTENT_SIMILARITY_PYTHON=backend/.venv/Scripts/python.exe
# 单次 MCP 调用总预算（秒），需覆盖模型加载与索引 I/O。
CONTENT_SIMILARITY_TIMEOUT_SECONDS=150
