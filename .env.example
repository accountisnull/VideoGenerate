# 媒体工具：填写 PATH 中的程序名、绝对路径或相对项目根目录的路径。
# Windows 路径建议使用正斜杠，例如 'C:/Tools/ffmpeg/bin/ffmpeg.exe'。
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 应用数据目录：支持相对项目根目录的路径或绝对路径。
VIDEO_DATA_DIR=data

# 文本模型：根据百炼账号所在地域填写接口地址和实际模型 ID。
# 共用密钥；各步骤也可通过 API_KEY_ENV 指定其他密钥变量名。
DASHSCOPE_API_KEY=

# 写稿模型：生成口播稿、发布标题和话题标签。
TEXT_WRITING_BASE_URL=
TEXT_WRITING_MODEL=
TEXT_WRITING_API_KEY_ENV=DASHSCOPE_API_KEY
TEXT_WRITING_TIMEOUT_SECONDS=60
TEXT_WRITING_GENERATION_OPTIONS='{}'

# 检查模型：按内容规则检查口播稿。
TEXT_REVIEW_BASE_URL=
TEXT_REVIEW_MODEL=
TEXT_REVIEW_API_KEY_ENV=DASHSCOPE_API_KEY
TEXT_REVIEW_TIMEOUT_SECONDS=60
TEXT_REVIEW_GENERATION_OPTIONS='{}'

# 改稿模型：根据检查反馈修改口播稿。
TEXT_REVISION_BASE_URL=
TEXT_REVISION_MODEL=
TEXT_REVISION_API_KEY_ENV=DASHSCOPE_API_KEY
TEXT_REVISION_TIMEOUT_SECONDS=60
TEXT_REVISION_GENERATION_OPTIONS='{}'
